<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/renameoneLinearLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/renameoneTextView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/renameoneImageView1"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_paste_dark"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@string/paste"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/renameoneEditText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:singleLine="true"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/renameoneImageView2"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_paste_dark"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="@string/paste"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/renameoneLinearLayout2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <CheckBox
                android:id="@+id/renameoneCheckBox1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/folders_rec"/>
            <CheckBox
                android:id="@+id/renameoneCheckBox2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/files_rec"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
