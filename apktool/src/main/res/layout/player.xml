<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/playerTextView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"/>
    <SeekBar
        android:id="@+id/playerSeekBar1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:ellipsize="middle"
        android:id="@+id/playerTextView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/playerLinearLayout1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <Button
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:id="@+id/playerButton1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prev_icon"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/playerTextView3"
            android:background="?android:attr/selectableItemBackground"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Button
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:id="@+id/playerButton2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/next_icon"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>
</LinearLayout>
