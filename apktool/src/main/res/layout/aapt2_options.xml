<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <CheckBox
            android:id="@+id/aapt2optionsCheckBox1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aapt2_dens"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <EditText
                android:id="@+id/aapt2optionsEditText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:singleLine="true"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/aapt2optionsImageView1"
                android:background="?android:attr/selectableItemBackground"
                android:padding="5dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_collapse"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"/>
        </LinearLayout>
        <TextView
            android:id="@+id/aapt2optionsTextView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/aapt2_dens_info"/>
        <CheckBox
            android:id="@+id/aapt2optionsCheckBox2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/aapt2_configs"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <EditText
                android:id="@+id/aapt2optionsEditText2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:singleLine="true"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/aapt2optionsImageView2"
                android:background="?android:attr/selectableItemBackground"
                android:padding="5dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_collapse"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"/>
        </LinearLayout>
        <TextView
            android:id="@+id/aapt2optionsTextView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/aapt2_configs_info"/>
        <CheckBox
            android:id="@+id/aapt2optionsCheckBox3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/lib_set"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <EditText
                android:id="@+id/aapt2optionsEditText3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:singleLine="true"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/aapt2optionsImageView3"
                android:background="?android:attr/selectableItemBackground"
                android:padding="5dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_collapse"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"/>
        </LinearLayout>
        <TextView
            android:id="@+id/aapt2optionsTextView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/aapt2_arch_info"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/mapp_minsdk"/>
        <Spinner
            android:id="@+id/aapt2optionsSpinner1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:singleLine="true"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/mapp_targetsdk"/>
        <Spinner
            android:id="@+id/aapt2optionsSpinner2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:singleLine="true"/>
    </LinearLayout>
</ScrollView>
