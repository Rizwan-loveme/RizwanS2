<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <EditText
                android:id="@+id/anametplEditText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:singleLine="true"
                android:layout_weight="1"
                android:contentDescription="@string/apk_template"/>
            <ImageView
                android:id="@+id/anametplImageView1"
                android:background="?android:attr/selectableItemBackground"
                android:padding="5dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_collapse"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"/>
            <Button
                android:id="@+id/anametplButton1"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="{}"
                android:contentDescription="@string/help_templates"
                style="?android:attr/buttonStyleSmall"/>
        </LinearLayout>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_templates_text"
            android:textIsSelectable="true"/>
        <EditText
            android:id="@+id/anametplEditText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="@string/search_hint"
            android:ems="10"
            android:singleLine="true"
            android:contentDescription="@string/remove_chars_info"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remove_chars_info"/>
    </LinearLayout>
</ScrollView>
