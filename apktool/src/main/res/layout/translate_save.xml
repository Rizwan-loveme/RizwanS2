<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <EditText
            android:id="@+id/translatesaveEditText1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="values-ru"
            android:ems="10"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="text"/>
        <ImageView
            android:id="@+id/translatesaveImageView1"
            android:background="?android:attr/selectableItemBackground"
            android:padding="5dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_collapse"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"/>
    </LinearLayout>
    <CheckBox
        android:id="@+id/translatesaveCheckBox2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:text="@string/mtr_combine"/>
    <CheckBox
        android:id="@+id/translatesaveCheckBox1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/mtr_only_tr"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mtr_info"/>
</LinearLayout>
