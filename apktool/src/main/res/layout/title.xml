<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/titleOpenDrawer"
        android:background="?android:attr/selectableItemBackground"
        android:padding="10dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_marginRight="0dp"
        android:src="@drawable/ic_menu_light"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:cropToPadding="true"
        android:contentDescription="@string/open_files"/>
    <TextView
        android:textSize="20sp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/name"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/app_name"
        android:singleLine="true"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/menu_expand"
        android:background="?android:attr/selectableItemBackground"
        android:padding="5dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_collapse"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:contentDescription="@string/list_files"/>
    <ImageView
        android:id="@+id/errors"
        android:background="?android:attr/selectableItemBackground"
        android:padding="5dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_error"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:contentDescription="@string/errors"/>
</LinearLayout>
