<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/translateTextView1"
        android:background="@color/red700"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/file_nw"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/translateLinearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Spinner
            android:id="@+id/translateSpinner1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <Spinner
            android:id="@+id/translateSpinner2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:id="@+id/translateView1"
        android:background="?android:attr/dividerVertical"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ru.maximoff.apktool.view.CustomListView
            android:id="@+id/translateListView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/translateLinearLayout1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="?android:attr/dividerVertical"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <EditText
                    android:id="@+id/translateEditText1"
                    android:paddingRight="@dimen/clear_ic_size"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/search_hint"
                    android:ems="10"
                    android:singleLine="true"/>
                <ImageView
                    android:id="@+id/clearText1"
                    android:padding="5dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/clear_ic_size"
                    android:layout_height="@dimen/clear_ic_size"
                    android:src="@drawable/ic_close"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/clear"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/translateImageView1"
                android:background="?android:attr/selectableItemBackground"
                android:padding="5dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_collapse"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <CheckBox
                android:ellipsize="end"
                android:id="@+id/translateCheckBox1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ex_match"
                android:layout_weight="1"/>
            <CheckBox
                android:ellipsize="end"
                android:id="@+id/translateCheckBox2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_sen2"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
