<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text="@string/name"
                android:singleLine="false"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/zippropTextView1"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:singleLine="false"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text="@string/path_app"
                android:singleLine="false"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/zippropTextView2"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:singleLine="false"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/zippropLinearLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text="@string/size_label"
                android:singleLine="false"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/zippropTextView3"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:singleLine="false"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/zippropLinearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text="@string/csize_label"
                android:singleLine="false"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/zippropTextView4"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:singleLine="false"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/zippropLinearLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CRC"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <EditText
                    android:id="@+id/zippropEditText0"
                    android:paddingRight="@dimen/clear_ic_size"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:singleLine="true"/>
                <ImageView
                    android:id="@+id/copyText0"
                    android:padding="5dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/clear_ic_size"
                    android:layout_height="@dimen/clear_ic_size"
                    android:src="@drawable/ic_copy"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/copy"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/zippropLinearLayout4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rename"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <EditText
                    android:id="@+id/zippropEditText1"
                    android:paddingRight="@dimen/clear_ic_size"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:singleLine="true"/>
                <ImageView
                    android:id="@+id/copyText1"
                    android:padding="5dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/clear_ic_size"
                    android:layout_height="@dimen/clear_ic_size"
                    android:src="@drawable/ic_copy"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/copy"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/zippropLinearLayout5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/zippropTextView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/modified"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <EditText
                    android:id="@+id/zippropEditText2"
                    android:paddingRight="@dimen/clear_ic_size"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:singleLine="true"/>
                <ImageView
                    android:id="@+id/copyText2"
                    android:padding="5dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/clear_ic_size"
                    android:layout_height="@dimen/clear_ic_size"
                    android:src="@drawable/ic_copy"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/copy"/>
            </RelativeLayout>
        </LinearLayout>
        <CheckBox
            android:id="@+id/zippropCheckBox1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mcompress"/>
    </LinearLayout>
</ScrollView>
