<resources>
    <style name="Theme.Gallery" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/gl_bg</item>
        <item name="android:statusBarColor">@color/gl_bg</item>
        <item name="android:navigationBarColor">@color/gl_bg</item>
        <item name="colorAccent">@color/gl_accent</item>
    </style>

    <!-- The photo viewer: a translucent window, so the screen behind it shows through while a picture is dragged
         down to close. The backdrop is a black view inside the activity. -->
    <style name="Theme.Gallery.Viewer">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
