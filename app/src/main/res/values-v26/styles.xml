<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 8.0 crashes when a translucent activity also locks its orientation, so use an opaque dark window here -->
    <style name="Theme.Win11.Glass" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#FF181B22</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
