<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- "Display over other apps": the floating popup player (FloatingPlayer) and the glass toast over other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application>
        <!-- Built-in YouTube app (opened from the Win11 Start menu) -->
        <activity
            android:name="com.srizwan.YouTube.YouTubeActivity"
            android:exported="false"
            android:theme="@style/Theme.YouTube"
            android:label="YouTube"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- Search screen (step 3): suggestions, filters (all / videos / channels / playlists), results.
             Opened from the search button of YouTubeActivity (YtNav.openSearch). -->
        <activity
            android:name="com.srizwan.YouTube.search.SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.YouTube"
            android:label="YouTube"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- History screen (step 4): watched videos and past searches (local, from YtHistory). -->
        <activity
            android:name="com.srizwan.YouTube.history.HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.YouTube"
            android:label="YouTube"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode" />

        <!-- Channel screen (step 5): header + Videos / Playlists tabs. Opened with YtNav.openChannel. -->
        <activity
            android:name="com.srizwan.YouTube.channel.ChannelActivity"
            android:exported="false"
            android:theme="@style/Theme.YouTube"
            android:label="YouTube"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode" />

        <!-- Playlist screen (step 5): header + the videos of the playlist. Opened with YtNav.openPlaylist. -->
        <activity
            android:name="com.srizwan.YouTube.playlist.PlaylistActivity"
            android:exported="false"
            android:theme="@style/Theme.YouTube"
            android:label="YouTube"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode" />

        <!-- Video player of the built-in YouTube app (part 1 of the player plan).
             Not exported: it is opened from inside Win11 with PlayerActivity.start().
             Part 7: no picture-in-picture any more; the video can float in a popup window over any app
             (FloatingPlayer, needs "Display over other apps"). -->
        <activity
            android:name="com.srizwan.YouTube.player.PlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.YouTube"
            android:label="YouTube"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|layoutDirection"
            android:resizeableActivity="true" />

        <!-- Background playback (part 5): foreground MediaSessionService around the shared player.
             Started with startForegroundService() from the visible player screen. -->
        <service
            android:name="com.srizwan.YouTube.player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
