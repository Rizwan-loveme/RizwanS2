<?xml version="1.0" encoding="utf-8"?>
<!-- Player screen. No text anywhere: every control is a vector icon (numbers such as the speed are drawn as
     glyph outlines by VectorLabelDrawable). The controls are GlassControls, not Media3's text controller. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:use_controller="false" />

    <com.srizwan.YouTube.ui.GlassControls
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- chip row, top right: floating window, background playback on / off, video quality (hidden when the
         video has one quality) and playback speed. It follows the visibility of the controls. -->
    <LinearLayout
        android:id="@+id/chip_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/float_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/yt_cd_float"
            android:minWidth="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <ImageView
            android:id="@+id/background_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/yt_cd_background"
            android:minWidth="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <ImageView
            android:id="@+id/quality_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/yt_cd_quality"
            android:minWidth="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/speed_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:contentDescription="@string/yt_cd_speed"
            android:minWidth="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <!-- touch gesture feedback (double-tap seek on both sides, volume / brightness swipes): icon + vector number -->
    <ImageView
        android:id="@+id/seek_hint_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="56dp"
        android:padding="12dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/seek_hint_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="56dp"
        android:padding="12dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/gesture_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:padding="12dp"
        android:visibility="gone" />

    <!-- resume hint: clock icon + saved time, and a start-over icon; shown for a few seconds -->
    <LinearLayout
        android:id="@+id/resume_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="96dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/resume_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/resume_restart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/yt_cd_restart"
            android:padding="10dp" />
    </LinearLayout>

    <!-- shown while the stream list is being fetched (before the player has anything to buffer) -->
    <ProgressBar
        android:id="@+id/fetch_progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/yt_red"
        android:visibility="gone" />

    <!-- error: an icon for the kind of problem (no connection / cannot play) and a retry icon -->
    <LinearLayout
        android:id="@+id/error_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/error_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/retry_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/yt_cd_retry"
            android:padding="16dp" />
    </LinearLayout>
</FrameLayout>
