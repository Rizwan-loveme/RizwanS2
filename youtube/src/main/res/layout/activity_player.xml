<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:use_controller="true" />

    <!-- chip row, top right: picture-in-picture (part 7), background playback on / off (part 5), video quality (part 3, hidden when the video has one quality) and playback speed (part 2).
         It follows the visibility of the player controls. -->
    <LinearLayout
        android:id="@+id/chip_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pip_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_yt_chip"
            android:contentDescription="@string/yt_player_pip_button"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/yt_player_pip_chip"
            android:textColor="@color/yt_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/background_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_yt_chip"
            android:contentDescription="@string/yt_player_background_button"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/yt_player_background_on"
            android:textColor="@color/yt_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quality_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_yt_chip"
            android:contentDescription="@string/yt_player_quality_button"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/yt_player_quality_auto"
            android:textColor="@color/yt_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/speed_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_yt_chip"
            android:contentDescription="@string/yt_player_speed_button"
            android:minWidth="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="1x"
            android:textColor="@color/yt_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- part 8: feedback of the touch gestures (double-tap seek on both sides, volume / brightness in the middle) -->
    <TextView
        android:id="@+id/seek_hint_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="56dp"
        android:background="@drawable/bg_yt_chip"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/yt_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/seek_hint_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bg_yt_chip"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/yt_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/gesture_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_yt_chip"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/yt_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- part 9: "Continuing from 12:34 | Start over", shown for a few seconds when a saved position was resumed -->
    <LinearLayout
        android:id="@+id/resume_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_yt_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/resume_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/yt_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/resume_restart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:padding="6dp"
            android:text="@string/yt_player_resume_restart"
            android:textColor="@color/yt_red"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- shown while the stream list is being fetched (before the player has anything to buffer) -->
    <ProgressBar
        android:id="@+id/fetch_progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/yt_red"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/yt_text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/yt_player_retry" />
    </LinearLayout>
</FrameLayout>
