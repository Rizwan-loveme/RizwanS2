<?xml version="1.0" encoding="utf-8"?>
<!-- :mame library manifest (MAME4droid Current v1.41.2). Differences from upstream's app manifest (see ../../../README.md step 3):
     * no <application> attributes (:app keeps its own: allowBackup, requestLegacyExternalStorage, theme, label, icon ...);
     * no MAIN / LAUNCHER / LEANBACK filter (no second launcher icon): MAME opens from Win11's Start menu, Home screen, rizwans2://mame (step 7);
     * the VIEW filter for application/zip and application/x-7z-compressed is removed (it would offer MAME for every zip on the phone);
     * MAME4droid is not exported (only Win11 starts it); icon / label / banner are set on the activity;
     * all activities run in their own process ":mame" and MAME4droid in its own task (taskAffinity): upstream ends MAME with
       finishAndRemoveTask() + Process.killProcess(myPid()) in 5 places, which would otherwise close the whole Win11 app (same idea as :midlet in :j2me);
     * no installLocation, no supports-screens (they would change :app). Permissions and features below already exist in :app or other modules. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NetPlay WifiLock (WifiLock.acquire() needs WAKE_LOCK) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 17 (API 37) local-network protection for LAN NetPlay; ignored on older Android -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application>
        <activity
            android:name="com.seleuco.mame4droid.MAME4droid"
            android:process=":mame"
            android:taskAffinity="com.seleuco.mame4droid.mame"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:icon="@mipmap/mm_ic_launcher"
            android:label="@string/mm_app_name"
            android:launchMode="singleTask"
            android:theme="@style/mm_Theme.MAME4droid"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity
            android:name="com.seleuco.mame4droid.prefs.UserPreferences"
            android:process=":mame"
            android:label="MAME4droid Settings"
            android:theme="@style/mm_Theme.MAME4droid.TitleBar" />
        <activity
            android:name="com.seleuco.mame4droid.WebHelpActivity"
            android:process=":mame"
            android:label="MAME4droid Help"
            android:launchMode="singleTop"
            android:theme="@style/mm_Theme.MAME4droid.TitleBar" />
        <activity
            android:name="com.seleuco.mame4droid.prefs.DefineKeys"
            android:process=":mame"
            android:label="MAME4droid Define Buttons"
            android:theme="@style/mm_Theme.MAME4droid.TitleBar" />
        <activity
            android:name="com.seleuco.mame4droid.prefs.ListKeys"
            android:process=":mame"
            android:label="MAME4droid Controller Buttons"
            android:theme="@style/mm_Theme.MAME4droid.TitleBar" />
        <activity
            android:name="com.seleuco.mame4droid.prefs.KeySelect"
            android:process=":mame"
            android:label="Select Key"
            android:theme="@android:style/Theme.Dialog" />
    </application>
</manifest>
