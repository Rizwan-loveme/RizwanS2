<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Same lines as :app, so the merge is a no-op. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 9 and older: the photo / video is written straight into DCIM/Camera (Android 10+ uses MediaStore, no permission).
         Same line as :gallery / :app, so the merge is a no-op. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- A device without a (front) camera can still install the app; the Camera screen shows an error then. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application>
        <!-- Built-in Camera app (live preview, photo, video, controls). Started with an explicit intent from the same
             app (Start menu, Home icon, rizwans2://camera deep link, Browser), so it stays exported="false". -->
        <activity
            android:name="com.srizwan.camera.CameraActivity"
            android:exported="false"
            android:theme="@style/Theme.Camera"
            android:label="Camera"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:resizeableActivity="true" />
    </application>
</manifest>
